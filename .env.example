# Database. SQLite file for local dev; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Public site URL, used for sitemap.xml, canonical links and social cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Affiliate tagging. If set, AffiliateButton appends ?<PARAM>=<VALUE> to
# every product's affiliate URL, e.g. AFFILIATE_TAG_PARAM="tag" and
# AFFILIATE_TAG_VALUE="yourstore-21" for Amazon Associates.
AFFILIATE_TAG_PARAM=""
AFFILIATE_TAG_VALUE=""

# Google AdSense publisher ID (ca-pub-...). Leave empty to show
# placeholder ad boxes in development.
NEXT_PUBLIC_ADSENSE_CLIENT=""
